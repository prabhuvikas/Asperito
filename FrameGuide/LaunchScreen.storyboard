 <scenes><scene sceneID="launch-scene"><objects>
  <viewController id="launch-controller" sceneMemberID="viewController">
   <view key="view" contentMode="scaleToFill" id="launch-root">
    <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
    <viewLayoutGuide key="safeArea" id="launch-safe"/>
    <subviews>
     <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="ASPERITO" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-wordmark">
      <rect key="frame" x="138" y="71" width="117" height="20"/>
      <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="16"/>
      <color key="textColor" red="0.9686" green="0.9529" blue="0.9176" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
